# Application runtime
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/sanfaani-storeapi

# Authentication and security
# Replace these distinct documentation-only placeholders with independently generated values.
# Each security secret must contain at least 32 characters.
JWT_SECRET=replace-with-a-32-plus-character-access-secret-placeholder
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-refresh-secret-placeholder
SECURITY_AUDIT_HMAC_SECRET=replace-with-an-independent-32-plus-character-audit-hmac-placeholder
CORS_ORIGIN=http://localhost:3000

# Payments
# PAYSTACK_MODE controls transaction mode independently of NODE_ENV.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace-with-secret
PAYSTACK_CALLBACK_URL=https://your-application.example.com/payment/callback

# Error monitoring (optional)
SENTRY_DSN=
