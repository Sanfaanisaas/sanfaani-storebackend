# Application runtime
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/sanfaani-storeapi

# Authentication
# Replace these placeholders with long, independently generated secrets.
JWT_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-secure-random-secret

# Payments
# Use sk_test_... in development/test and sk_live_... in production.
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-paystack-secret-key
PAYSTACK_CALLBACK_URL=https://your-application.example.com/payment/callback

# Error monitoring (optional)
SENTRY_DSN=
